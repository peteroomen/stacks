# --- Supabase (filled in once the project exists) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, used by the ingest cron

# --- AI (you set this tomorrow) ---
ANTHROPIC_API_KEY=

# --- ListenBrainz ingestion (you set this tomorrow) ---
LISTENBRAINZ_USER=                  # your ListenBrainz username (reads are public)
OWNER_USER_ID=                      # your Supabase auth user uuid (owns all rows)

# --- Cron protection ---
CRON_SECRET=                        # random string; Vercel sends it as Bearer on cron calls
